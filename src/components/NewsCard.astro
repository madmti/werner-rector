---
import { urlFor, formatDate, type Post } from '@/lib/sanity';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const imageUrl = post.mainImage ? urlFor(post.mainImage).width(800).auto('format').url() : undefined;
---

<a
  href={`/noticias/${post.slug}`}
  class="group flex flex-col h-full overflow-hidden rounded-2xl border border-brand-azul/10 bg-white shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
>
  <div class="aspect-[16/10] overflow-hidden bg-brand-azul/10">
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={post.mainImage?.alt || post.title}
        width="800"
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <span class="font-bold text-4xl text-brand-azul/20">W</span>
      </div>
    )}
  </div>

  <div class="flex flex-col gap-2 p-6 flex-1">
    <time class="text-sm font-bold text-brand-amarillo uppercase tracking-wide">{formatDate(post.publishedAt)}</time>
    <h3 class="text-xl font-bold text-brand-azul leading-tight group-hover:underline">{post.title}</h3>
    {post.excerpt && (
      <p class="text-sm text-gray-600 leading-relaxed line-clamp-3 mt-auto pt-2">{post.excerpt}</p>
    )}
  </div>
</a>
