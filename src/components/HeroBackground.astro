---
import { Image } from 'astro:assets';
import backgroundImg from '../assets/Hero/background.png';
import wFondo from '../assets/Hero/w_werner@4x.png';
---

<div class="absolute inset-0">
  <Image
    src={backgroundImg}
    alt="Fondo de Mar"
    class="absolute inset-0 w-full h-full object-cover z-0"
  />
  <div class="absolute inset-0 bg-[#181c33]/50 z-1"></div>
  <div class="absolute inset-0 flex justify-center items-center pointer-events-none z-10">
    <Image
      src={wFondo}
      alt="W de fondo"
      class="w-[120%] max-sm:translate-y-[-10vh] md:w-[70%] max-w-300 h-auto object-contain opacity-[0.12]"
    />
  </div>
</div>
