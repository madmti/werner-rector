---
import { getImage, Image } from 'astro:assets';
import backgroundImg from '../assets/Hero/background.webp';
import wFondo from '../assets/Hero/w_werner@4x.webp';

const backgroundFull = await getImage({ src: backgroundImg, width: 1600 });
const backgroundPlaceholder = await getImage({ src: backgroundImg, width: 32, quality: 20 });
---

<div class="absolute inset-0">
  <img
    src={backgroundPlaceholder.src}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover z-0 blur-lg scale-110"
  />
  <img
    src={backgroundFull.src}
    alt="Fondo de Mar"
    width={backgroundFull.attributes.width}
    height={backgroundFull.attributes.height}
    loading="lazy"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover z-0 blur-xs scale-105"
  />
  <div class="absolute inset-0 bg-[#181c33]/50 z-1"></div>
  <div class="absolute inset-0 flex justify-center items-center pointer-events-none z-10">
    <Image
      src={wFondo}
      alt="W de fondo"
      class="w-[120%] max-sm:translate-y-[-10vh] md:w-[70%] max-w-300 h-auto object-contain opacity-[0.12]"
    />
  </div>
</div>
