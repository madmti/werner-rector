---
import { Image } from 'astro:assets';
import iconBlanco from '../assets/icons/W fondo blanco.png';
import iconAzul from '../assets/icons/W fondo azul.png';

interface Props {
  text: string;
  variant?: 'blanca' | 'azul';
}

const { text, variant = 'blanca' } = Astro.props;

const isBlanca = variant === 'blanca';
const iconSrc = isBlanca ? iconBlanco : iconAzul;

const styles = isBlanca
  ? 'border-white text-white bg-black/20'
  : 'border-brand-azul text-brand-azul bg-white/90';
---

<div class={`inline-flex items-center gap-2 md:gap-3 border rounded-full py-1 md:py-1.5 pr-4 md:pr-6 pl-1 md:pl-1.5 backdrop-blur-sm w-max ${styles}`}>
  <Image
    src={iconSrc}
    alt="Icono W"
    class="w-6 h-6 md:w-8 md:h-8 rounded-full object-contain"
  />
  <span class="font-bold text-sm md:text-base tracking-wide">{text}</span>
</div>
