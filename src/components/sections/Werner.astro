---
import { getImage, Image } from 'astro:assets';
import Badge from '@/components/Badge.astro';
import iconAzul from '@/assets/icons/W fondo azul.webp';

import imgDefault from '@/assets/Werner/IMG_0211,.1.webp';
import imgQuien from '@/assets/Werner/Quien es werner.webp';
import imgExp from '@/assets/Werner/experiencia internacional.webp';
import imgLiderazgo from '@/assets/Werner/Liderazgo universitario.webp';
import imgProfesor from '@/assets/Werner/Profesor.webp';
import imgInvestigador from '@/assets/Werner/Investigador.webp';

// Helper para optimizar cada imagen repetitivamente
async function optimizeImage(srcObj: any) {
  const originalWidth = srcObj?.width ?? 1200;
  const candidateWidths = [400, 800, 1200, 1920].filter(w => w <= originalWidth);
  const widths = candidateWidths.length ? candidateWidths : [originalWidth];

  const full = await getImage({ src: srcObj, widths, sizes: '(min-width: 1024px) 50vw, 100vw', quality: 85, format: 'webp' });
  const placeholder = await getImage({ src: srcObj, width: 32, quality: 20, format: 'webp' });
  
  return {
    src: full.src,
    srcSet: full.srcSet.attribute,
    sizes: full.attributes.sizes,
    width: full.attributes.width,
    height: full.attributes.height,
    placeholder: placeholder.src
  };
}

const optDefault = await optimizeImage(imgDefault);
const optQuien = await optimizeImage(imgQuien);
const optExp = await optimizeImage(imgExp);
const optLiderazgo = await optimizeImage(imgLiderazgo);
const optProfesor = await optimizeImage(imgProfesor);
const optInvestigador = await optimizeImage(imgInvestigador);

const cards = [
  {
    title: '¿Quién es Werner?',
    image: optQuien,
    content: 'Ingeniero Electrónico y Magíster en Electrónica de la UTFSM, Doctor por la Universidad de Tokio y académico del Departamento de Electrónica. Su trayectoria combina investigación, innovación, docencia y gestión universitaria, siempre con un mismo propósito: fortalecer el rol de la Universidad como motor de desarrollo para Chile.',
  },
  {
    title: 'Experiencia internacional',
    image: optExp,
    content: 'Su experiencia profesional se desarrolló en Tokio, donde trabajó en NEC Corporation liderando proyectos tecnológicos para países del sudeste asiático. Posteriormente fundó SENDA Ltd., empresa desde la cual impulsó soluciones digitales y alianzas estratégicas con proyección internacional. Esta etapa consolidó una visión global de la innovación, la transferencia tecnológica y la colaboración entre la academia y la industria.',
  },
  {
    title: 'Liderazgo universitario',
    image: optLiderazgo,
    content: 'Durante más de quince años ha asumido distintos desafíos de liderazgo dentro de la UTFSM. Como Director del Departamento de Electrónica y exdirector de la Oficina de Transferencia Tecnológica impulsó proyectos que fortalecen la investigación, la innovación y la vinculación con el entorno.',
  },
  {
    title: 'Profesor',
    image: optProfesor,
    content: 'Convencido de que la excelencia comienza en el aula, ha desarrollado cursos en inteligencia artificial, aprendizaje automático y tecnologías digitales, incorporando metodologías activas y herramientas innovadoras para potenciar la formación de sus estudiantes. En 2019, este enfoque lo llevó a ser invitado por Texas A&M University para replicar su experiencia docente durante un año.',
  },
  {
    title: 'Investigador',
    image: optInvestigador,
    content: 'Su trabajo científico se centra en inteligencia artificial, visión computacional, aprendizaje profundo y analítica de datos, colaborando en proyectos interdisciplinarios con impacto en minería, salud, educación y transformación digital.',
  },
  {
    title: '¿Por qué postula a rector?',
    image: optDefault,
    content: 'Porque creo que la UTFSM tiene las capacidades para convertirse en la principal universidad tecnológica de América Latina. Mi propuesta busca fortalecer el liderazgo académico, poner la gestión al servicio de la comunidad y reconstruir una universidad más integrada, conectada con el país y preparada para los desafíos del futuro.',
  },
];
---

<section class="grid grid-cols-1 lg:grid-cols-2 min-h-screen" id="werner">
  <!-- LEFT: background image + overlay + text -->
  <div class="relative overflow-hidden flex items-center min-h-[50vh] lg:min-h-screen bg-black">
    
    <img
      id="bg-werner-default"
      src={optDefault.src}
      srcset={optDefault.srcSet}
      sizes={optDefault.sizes}
      alt=""
      width={optDefault.width}
      height={optDefault.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="werner-bg-layer absolute inset-0 w-full h-full object-cover object-[80%] transition-opacity duration-700 ease-in-out opacity-100"
    />

    {
      cards.map((card, i) => (
        <img
          id={`bg-werner-${i}`}
          src={card.image.src}
          srcset={card.image.srcSet}
          sizes={card.image.sizes}
          alt=""
          width={card.image.width}
          height={card.image.height}
          loading="lazy"
          decoding="async"
          class="werner-bg-layer absolute inset-0 w-full h-full object-cover object-[80%] transition-opacity duration-700 ease-in-out opacity-0"
        />
      ))
    }
    
    <div class="absolute inset-0 bg-linear-to-r from-black/50 via-black/20 to-transparent pointer-events-none" />
    
    <div id="werner-title-container" class="relative z-10 px-6 sm:px-8 lg:px-12 py-12 lg:py-0 w-full lg:max-w-[640px] lg:ml-auto transition-all duration-500 opacity-100 translate-y-0">
      <div data-reveal><Badge text="Werner" /></div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-wide mt-4 drop-shadow-md" data-reveal style="--reveal-delay: 0.1s">
        Conoce a<br />Werner Creixell
      </h1>
    </div>
  </div>

  <!-- RIGHT: master–detail list -->
  <div class="flex flex-col justify-center gap-3 px-6 sm:px-8 lg:px-12 py-12 lg:py-0 bg-white lg:max-w-[640px] lg:mr-auto" id="werner-list" data-reveal style="--reveal-delay: 0.2s">
    {
      cards.map((card, i) => (
        <div class="werner-wrap grid transition-all duration-500" style="grid-template-rows: 1fr;">
          <div class="overflow-hidden min-h-0">
            <!-- Asignamos TODOS los atributos de la imagen al dataset para inyectarlos vía JS -->
            <div 
              class="werner-item" 
              data-src={card.image.src} 
              data-srcset={card.image.srcSet} 
              data-sizes={card.image.sizes} 
              data-placeholder={card.image.placeholder}
              data-index={i}
            >
              <button
                class="werner-header group flex items-center gap-3 w-full rounded-full border border-brand-azul/15 py-3 pr-5 pl-2 bg-white/80 backdrop-blur-sm cursor-pointer transition-all duration-300 hover:border-brand-azul/30 active:bg-brand-azul active:text-white active:border-brand-azul"
              >
                <span class="icon-container w-12 h-12 rounded-full bg-brand-azul/10 flex items-center justify-center shrink-0 group-active:bg-white/20 transition-colors">
                  <Image src={iconAzul} alt="" class="w-12 h-12 object-contain" widths={[96, 192]} sizes="48px" />
                </span>
                <span class="title-text font-bold text-brand-azul text-base flex-1 group-active:text-white transition-colors">
                  {card.title}
                </span>
                <svg
                  class="werner-arrow w-4 h-4 text-brand-azul/35 transition-all duration-300 shrink-0 group-active:text-white"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </button>
              <div class="werner-body grid transition-all duration-500" style="grid-template-rows: 0fr;">
                <div class="overflow-hidden min-h-0">
                  <div class="pt-4 pb-2 px-2 text-gray-600 leading-relaxed">
                    {card.content}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .werner-item.active .werner-header {
    background-color: var(--color-brand-azul);
    color: white;
    border-color: var(--color-brand-azul);
  }
  .werner-item.active .werner-header .icon-container {
    background-color: rgba(255, 255, 255, 0.2);
  }
  .werner-item.active .werner-header .title-text {
    color: white;
  }
  .werner-item.active .werner-arrow {
    color: white;
    transform: rotate(180deg);
  }

  #werner-title-container.hide-title {
    opacity: 0;
    transform: translateY(-15px);
    pointer-events: none;
    visibility: hidden;
  }
</style>

<script is:inline>
  const list = document.getElementById('werner-list');
  if (!list) throw new Error('#werner-list not found');

  const wraps = list.querySelectorAll('.werner-wrap');
  const items = list.querySelectorAll('.werner-item');
  const bodies = list.querySelectorAll('.werner-body');
  const titleContainer = document.getElementById('werner-title-container');
  const bgLayers = document.querySelectorAll('.werner-bg-layer');
  let activeIndex = -1;

  function updateBackground(index) {
    const targetId = index === -1 ? 'bg-werner-default' : `bg-werner-${index}`;
    bgLayers.forEach(bg => {
      if (bg.id === targetId) {
        bg.style.opacity = '1';
      } else {
        bg.style.opacity = '0';
      }
    });
  }

  function closeAll() {
    wraps.forEach(w => (w.style.gridTemplateRows = '1fr'));
    items.forEach((item, i) => {
      item.classList.remove('active');
      item.style.order = '';
      bodies[i].style.gridTemplateRows = '0fr';
    });
    activeIndex = -1;
    updateBackground(-1);
  }

  function openItem(index) {
    if (activeIndex === index) {
      closeAll();
      return;
    }

    const prevIndex = activeIndex;

    // Collapse previous body if there was one
    if (prevIndex !== -1) {
      bodies[prevIndex].style.gridTemplateRows = '0fr';
      items[prevIndex].classList.remove('active');
      items[prevIndex].style.order = '';
    }

    // Expand current
    items[index].classList.add('active');
    items[index].style.order = '-1';

    if (titleContainer) titleContainer.classList.add('hide-title');

    // Swap background image, srcset, sizes, and placeholder
    updateBackground(index);

    // Show current wrap, collapse all other wraps
    wraps.forEach((wrap, i) => {
      wrap.style.gridTemplateRows = i === index ? '1fr' : '0fr';
    });

    // Body expands after a tick so the wrapper is already open
    requestAnimationFrame(() => {
      bodies[index].style.gridTemplateRows = '1fr';
    });

    activeIndex = index;
  }

  items.forEach((item, i) => {
    const header = item.querySelector('.werner-header');
    header.addEventListener('click', () => openItem(i));
  });
</script>
