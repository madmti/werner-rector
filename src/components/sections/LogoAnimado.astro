---
import { Image } from 'astro:assets';
import logo04 from '@/assets/LogoAnimado/Logo werner creixell-04.png';
import logo08 from '@/assets/LogoAnimado/Logo werner creixell-08.png';
import usmLogo from '@/assets/LogoAnimado/25.-USM.png';
---

<section class="relative h-[200vh] bg-white" id="logo-animado">
  <div class="sticky top-0 h-screen flex items-center justify-center overflow-hidden">
    <div class="relative w-full h-full flex items-center justify-center">

      <!-- 04: full logo + firma -->
      <Image
        src={logo04}
        alt="Logo Werner Creixell"
        class="absolute inset-0 w-full h-full object-contain p-4 md:p-8"
        id="logo-04"
      />

      <!-- 08: solo W + contenido overlay -->
      <div class="absolute inset-0 w-full h-full p-4 md:p-8" id="layer-08">
        <div class="relative w-full h-full flex items-center justify-center">
          <Image
            src={logo08}
            alt=""
            class="absolute inset-0 w-full h-full object-contain"
          />

          <div class="absolute inset-0 flex items-center justify-center">
            <!-- spacer left to push content to right half of image -->
            <div class="w-1/2" />
            <div class="w-1/2 flex items-center justify-center pr-4 md:pr-8 lg:pr-12">
              <div class="space-y-10">
                <!-- 3 CAMPUS / 2 SEDES -->
                <div class="grid grid-cols-2 gap-x-10 gap-y-3">
                  <div>
                    <p class="font-bold text-xl md:text-2xl uppercase text-brand-azul mb-3">3 Campus</p>
                    <div class="space-y-3">
                      <span class="flex items-center gap-3 text-lg md:text-xl text-brand-azul">
                        <span class="w-4 h-4 rounded-full bg-brand-amarillo shrink-0" />
                        Campus Vitacura
                      </span>
                      <span class="flex items-center gap-3 text-lg md:text-xl text-brand-azul">
                        <span class="w-4 h-4 rounded-full bg-brand-azul shrink-0" />
                        Campus Casa Central
                      </span>
                      <span class="flex items-center gap-3 text-lg md:text-xl text-brand-azul">
                        <span class="w-4 h-4 rounded-full bg-brand-rojo shrink-0" />
                        Campus San Joaquín
                      </span>
                    </div>
                  </div>
                  <div>
                    <p class="font-bold text-xl md:text-2xl uppercase text-brand-azul mb-3">2 Sedes</p>
                    <div class="space-y-3">
                      <span class="flex items-center gap-3 text-lg md:text-xl text-brand-azul">
                        <span class="w-4 h-4 rounded-full bg-brand-verde shrink-0" />
                        Sede Viña del Mar
                      </span>
                      <span class="flex items-center gap-3 text-lg md:text-xl text-brand-azul">
                        <span class="w-4 h-4 rounded-full bg-black shrink-0" />
                        Sede Concepción
                      </span>
                    </div>
                  </div>
                </div>

                <!-- 1 UNIVERSIDAD -->
                <div>
                  <p class="font-bold text-xl md:text-2xl uppercase text-brand-azul mb-3">1 Universidad</p>
                  <Image
                    src={usmLogo}
                    alt="Universidad Técnica Federico Santa María"
                    class="h-14 md:h-20 w-auto object-contain"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const section = document.getElementById('logo-animado')!;
  const logo04 = document.getElementById('logo-04')!;
  const layer08 = document.getElementById('layer-08')!;

  function update() {
    const rect = section.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const safeArea = 120;
    const progress = Math.max(0, Math.min(1, (safeArea - rect.top) / total));
    logo04.style.opacity = String(1 - progress);
    layer08.style.opacity = String(progress);
  }

  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
