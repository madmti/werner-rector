---
import { Image } from 'astro:assets';
import logo04 from '@/assets/LogoAnimado/Logo werner creixell-04.webp';
import logo08 from '@/assets/LogoAnimado/Logo werner creixell-08.webp';
import left04 from '@/assets/LogoAnimado/halves/04-left.webp';
import right04 from '@/assets/LogoAnimado/halves/04-right.webp';
import left08 from '@/assets/LogoAnimado/halves/08-left.webp';
import linea from '@/assets/LogoAnimado/Linea.webp';
import CampusData from '@/components/CampusData.astro';
---

<section class="relative h-[130vh]" id="logo-animado">
  <div class="sticky top-0 h-screen overflow-hidden">
    <div class="relative w-full h-full">

      <!-- ============ DESKTOP ============ -->
      <Image
        src={logo04}
        alt="Logo Werner Creixell"
        class="logo-04 max-sm:hidden absolute inset-0 w-full h-full object-contain p-4 md:p-8"
      />

      <div class="layer-08 max-sm:hidden absolute inset-0 p-4 md:p-8" style="opacity:0">
        <div class="relative w-full h-full">
          <Image src={logo08} alt="" class="absolute inset-0 w-full h-full object-contain" />
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-1/2" />
            <div class="w-1/2 flex items-center justify-center pr-4 md:pr-8 lg:pr-12">
              <CampusData />
            </div>
          </div>
        </div>
      </div>

      <!-- ============ MOBILE ============ -->
      <!-- Both 04 and 08 share the same structure so positions match.
           Bottom half reserves space for CampusData (visible only in 08). -->

      <!-- 04: both halves stacked + invisible spacer for text area -->
      <div class="logo-04 sm:hidden absolute inset-0 flex flex-col items-center justify-center px-4">
        <div class="w-full max-w-md">
          <div class="w-full aspect-video">
            <Image src={left04} alt="" class="w-full h-full object-contain" />
          </div>
        </div>
        <div class="w-full max-w-md">
          <div class="w-full flex items-center justify-center relative">
              <div class="w-full aspect-video absolute">
                <Image src={right04} alt="" class="w-full h-full object-contain" />
              </div>

            <div class="invisible"><CampusData /></div>
          </div>
        </div>
      </div>

      <!-- 08 + campus: same structure with images swapped + visible text -->
      <div class="layer-08 sm:hidden absolute inset-0 flex flex-col items-center justify-center px-4" style="opacity:0">
        <div class="w-full max-w-md">
          <div class="w-full aspect-video">
            <Image src={left08} alt="" class="w-full h-full object-contain" />
          </div>
        </div>
        <div class="w-full max-w-md">
          <div class="w-full flex items-center justify-center">
            <CampusData />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<section class="flex flex-col items-center justify-center bg-white px-4 pb-12 md:pb-16 mt-[-15vh] sm:mt-[-20vh] gap-4 text-center">
  <div class="space-y-1">
    <p class="text-3xl md:text-5xl lg:text-[3.5rem] leading-tight text-brand-azul" data-reveal>
      Unidos para <strong>formar</strong>
    </p>
    <p class="text-3xl md:text-5xl lg:text-[3.5rem] leading-tight text-brand-azul" data-reveal style="--reveal-delay: 0.15s">
      Formar para <strong>transformar</strong>
    </p>
  </div>
  <Image src={linea} alt="" class="w-3/4 max-w-sm object-contain" style="height: auto" data-reveal />
  <p class="text-xl md:text-2xl lg:text-[1.8rem] italic font-light text-brand-azul" data-reveal style="--reveal-delay: 0.3s">
    Porque somos todos sansanos
  </p>
</section>

<script is:inline>
  const section = document.getElementById('logo-animado');
  const logos04 = section.querySelectorAll('.logo-04');
  const layers08 = section.querySelectorAll('.layer-08');

  function update() {
    const rect = section.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const progress = Math.max(0, Math.min(1, -rect.top / total));

    logos04.forEach(el => el.style.opacity = String(1 - progress));
    layers08.forEach(el => el.style.opacity = String(progress));
  }

  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
