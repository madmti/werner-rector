---
import Badge from "@/components/Badge.astro";
---

<section class="relative w-full bg-white py-12 md:py-16 lg:py-20" id="noticias">
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex flex-col gap-2 mb-8 lg:mb-10">
      <Badge text="Noticias" variant="azul" />
      <h2 class="text-5xl sm:text-6xl md:text-7xl text-brand-azul leading-[0.9] tracking-tight mt-2 flex gap-2 items-center">
        <span class="font-normal">Últimas</span>
        <span class="font-bold">noticias</span>
      </h2>
    </div>

    <div id="noticias-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      <!-- TODO: reemplazar por tarjetas de noticias cuando lleguen los datos de Sanity -->
      <div id="noticias-empty" class="col-span-full flex flex-col items-center justify-center text-center gap-2 py-14 md:py-20">
        <p class="text-xl md:text-2xl font-bold text-brand-azul/60">Próximamente</p>
        <p class="text-base md:text-lg text-brand-azul/40">
          Pronto compartiremos las noticias de la campaña.
        </p>
      </div>
    </div>
  </div>
</section>
