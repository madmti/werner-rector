---
import { getImage } from 'astro:assets';
import wernerSolo from '../../assets/Hero/werner.webp';
import HeroBackground from '../HeroBackground.astro';
import HeroContent from '../HeroContent.astro';

const wernerSoloFull = await getImage({ src: wernerSolo });
const wernerSoloPlaceholder = await getImage({ src: wernerSolo, width: 500, quality: 20 });
---

<section class="relative min-h-dvh w-full overflow-hidden flex items-center justify-center">
  <HeroBackground />

  <div class="relative z-30 w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-0 md:pt-32 pb-24 flex flex-col md:flex-row items-center justify-end md:justify-start h-full min-h-dvh">
    <HeroContent />
  </div>

  <div class="absolute md:translate-x-[20vw] bottom-[-20vh] z-20 pointer-events-none h-screen flex items-end">
    <div class="relative h-[95vh] sm:w-150 aspect-1277/2065">
      <img
        src={wernerSoloPlaceholder.src}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover blur-lg scale-110"
      />
      <img
        src={wernerSoloFull.src}
        alt="Werner Creixell"
        width={wernerSoloFull.attributes.width}
        height={wernerSoloFull.attributes.height}
        loading="eager"
        decoding="sync"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover drop-shadow-[0_0_40px_rgba(255,255,255,0.5)] lqip-reveal"
      />
    </div>
  </div>
</section>

<style>
  @keyframes lqip-reveal {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .lqip-reveal {
    animation: lqip-reveal 1s ease-out 0.2s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .lqip-reveal {
      animation: none;
    }
  }
</style>
