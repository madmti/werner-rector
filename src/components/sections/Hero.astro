---
import { getImage } from 'astro:assets';
import wernerSolo from '../../assets/Hero/wener_solo.webp';
import HeroBackground from '../HeroBackground.astro';
import HeroContent from '../HeroContent.astro';

const wernerSoloFull = await getImage({ src: wernerSolo });
const wernerSoloPlaceholder = await getImage({ src: wernerSolo, width: 500, quality: 20 });
---

<section class="relative min-h-dvh w-full overflow-hidden flex items-center">
  <HeroBackground />

  <div class="relative z-30 w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-0 md:pt-32 pb-24 flex flex-col md:flex-row items-center justify-end md:justify-start h-full min-h-dvh">
    <HeroContent />
  </div>

  <div class="absolute z-20 pointer-events-none overflow-hidden h-screen flex items-end sm:items-center">
    <div class="relative md:translate-x-[20vw]">
      <img
        src={wernerSoloPlaceholder.src}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover blur-lg scale-110"
      />
      <img
        src={wernerSoloFull.src}
        alt="Werner Creixell"
        width={wernerSoloFull.attributes.width}
        height={wernerSoloFull.attributes.height}
        loading="eager"
        decoding="sync"
        fetchpriority="high"
        class="w-full h-[110vh] md:h-[180vh] object-cover drop-shadow-[0_0_40px_rgba(255,255,255,0.5)]"
      />
    </div>
  </div>
</section>
