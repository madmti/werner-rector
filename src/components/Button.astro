---
interface Props {
  variant?: 'normal' | 'outlined' | 'primary';
  href?: string;
  class?: string;
}

const { variant = 'normal', href, class: className = '' } = Astro.props;

const baseStyles = 'inline-flex items-center justify-center gap-2 px-6 py-2 rounded-full font-bold transition-all duration-300 w-max';

const variants = {
  normal: 'bg-white text-brand-azul hover:bg-gray-100',
  outlined: 'bg-transparent border-2 border-white text-white hover:bg-white hover:text-brand-azul',
  primary: 'bg-brand-azul text-white hover:bg-brand-azul/90'
};

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={`${baseStyles} ${variants[variant]} ${className}`}>
  <slot />
</Tag>
