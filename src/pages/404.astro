---
import MainLayout from '@/layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import logoRector from '@/assets/Hero/logo_werner_creixell_rector.webp';
import Button from '@/components/Button.astro';
---

<MainLayout
  title="Página no encontrada | Werner Creixell"
  description="La página que buscas no existe o fue movida. Volver al inicio."
>
  <div class="min-h-dvh flex flex-col bg-white">
    <header class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-6">
      <a href="/" class="shrink-0 inline-block">
        <Image src={logoRector} alt="Logo Werner Creixell" class="h-10 sm:h-12 w-auto object-contain" />
      </a>
    </header>

    <div class="flex-1 w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 flex flex-col items-center justify-center text-center py-16">
      <p class="text-3xl sm:text-4xl md:text-5xl font-bold text-brand-azul leading-tight mt-4">
        Página no encontrada
      </p>
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed mt-4 max-w-lg">
        La página que buscas no existe o fue movida. Pero la campaña sigue firme.
      </p>

      <div class="mt-8">
        <Button variant="primary" href="/" class="px-8 py-3 text-base shadow-lg">
          Volver al inicio
        </Button>
      </div>
    </div>
  </div>
</MainLayout>
